/* ==========================================================
   Global
   ========================================================== */

QWidget {
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
    color: palette(text);
    background: transparent;
}

/* ==========================================================
   Header
   ========================================================== */

#headerWidget {
    background: transparent;
}

#logoLabel {
    background: transparent;
    border: none;
}

#titleLabel {
    background: transparent;
    border: none;
    font-size: 20px;
    font-weight: 700;
    color: palette(text);
}

#subtitleLabel {
    background: transparent;
    border: none;
    font-size: 15px;
    font-weight: 500;
    color: palette(text);
    opacity: 0.7;
}

/* ==========================================================
   Form Label
   ========================================================== */

#fieldLabel {
    background: transparent;
    border: none;
    font-weight: 600;
    color: palette(text);
    padding-bottom: 2px;
}

/* ==========================================================
   Line Edit
   ========================================================== */

QLineEdit {
    background: palette(base);
    color: palette(text);
    border: 1px solid palette(midlight);
    border-radius: 7px;
    padding: 0px 10px;
    selection-background-color: #10B981;
}

QLineEdit:hover {
    border: 1px solid #10B981;
}

QLineEdit:focus {
    border: 1.5px solid #10B981;
}

/* ==========================================================
   Checkbox
   ========================================================== */

QCheckBox {
    background: transparent;
    color: palette(text);
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 1px solid palette(midlight);
    border-radius: 4px;
    background: palette(base);
}

QCheckBox::indicator:checked {
    border: 1px solid #10B981;
    background: #10B981;
}


/* ==========================================================
   Login Button
   ========================================================== */

#loginButton {

    background: #2E9E55;

    color: white;

    border: none;

    border-radius: 7px;

    font-weight: bold;

    font-size: 10pt;

}


#loginButton:hover {

    background: #39AF61;

}


#loginButton:pressed {

    background: #247D45;

}


#loginButton:disabled {

    background: #BDBDBD;

    color: white;

}


/* ==========================================================
   Status
   ========================================================== */

#statusLabel {
    background: transparent;
    border: none;
    color: palette(text);
    opacity: 0.8;
    font-size: 9pt;
}

/* ==========================================================
   Tab Widget
   ========================================================== */

QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    border: none;
    min-width: 95px;
    padding: 10px;
    color: palette(text);
    opacity: 0.8;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #10B981;
    border-bottom: 3px solid #10B981;
    opacity: 1.0;
}

QTabBar::tab:hover {
    color: #10B981;
}