/* ==========================================================
   Global
   ========================================================== */

QWidget {

    font-family: "Segoe UI";

    font-size: 9pt;

    color: #2d2d2d;

    background: transparent;

}


/* ==========================================================
   Header
   ========================================================== */

#headerWidget {

    background: transparent;

}


#logoLabel {

    background: transparent;

    border: none;

}


#titleLabel {

    background: transparent;

    border: none;

    font-size: 22px;

    font-weight: 700;

    color: #1f1f1f;

}


#subtitleLabel {

    background: transparent;

    border: none;

    font-size: 18px;

    font-weight: 500;

    color: #6b6b6b;

}


/* ==========================================================
   Form Label
   ========================================================== */

#fieldLabel {

    background: transparent;

    border: none;

    font-weight: 600;

    color: #444444;

    padding-bottom: 2px;

}


/* ==========================================================
   Line Edit
   ========================================================== */

QLineEdit {

    background: white;

    border: 1px solid #d7d7d7;

    border-radius: 7px;

    padding: 0px 10px;

    selection-background-color: #2E9E55;

}


QLineEdit:hover {

    border: 1px solid #7fc68f;

}


QLineEdit:focus {

    border: 1px solid #2E9E55;

}


/* ==========================================================
   Checkbox
   ========================================================== */

QCheckBox {

    background: transparent;

    spacing: 8px;

}


QCheckBox::indicator {

    width: 18px;

    height: 18px;

}


QCheckBox::indicator:unchecked {

    border: 1px solid #BDBDBD;

    border-radius: 4px;

    background: white;

}


QCheckBox::indicator:checked {

    border: 1px solid #2E9E55;

    background: #2E9E55;

}


/* ==========================================================
   Login Button
   ========================================================== */

#loginButton {

    background: #2E9E55;

    color: white;

    border: none;

    border-radius: 7px;

    font-weight: bold;

    font-size: 10pt;

}


#loginButton:hover {

    background: #39AF61;

}


#loginButton:pressed {

    background: #247D45;

}


#loginButton:disabled {

    background: #BDBDBD;

    color: white;

}


/* ==========================================================
   Status
   ========================================================== */

#statusLabel {

    background: transparent;

    border: none;

    color: #666666;

    font-size: 9pt;

}


/* ==========================================================
   Tab Widget
   ========================================================== */

QTabWidget::pane {

    border: none;

    background: transparent;

}


QTabBar::tab {

    background: transparent;

    border: none;

    min-width: 95px;

    padding: 10px;

    color: #666666;

    font-weight: 600;

}


QTabBar::tab:selected {

    color: #2E9E55;

    border-bottom: 3px solid #2E9E55;

}


QTabBar::tab:hover {

    color: #2E9E55;

}