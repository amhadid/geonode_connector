/* ==========================================================
   GeoNode Connector Modern Design System (main.qss)
   ========================================================== */

* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    outline: none;
}

QWidget {
    color: #1E293B;
    font-size: 9pt;
}

QLabel {
    border: none;
    background: transparent;
}

/* ----------------------------------------------------------
   Scrollbar Modern
---------------------------------------------------------- */
QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    height: 8px;
    background: transparent;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
}

/* ----------------------------------------------------------
   Tabs Modern
---------------------------------------------------------- */
QTabWidget::pane {
    border: none;
    background: #FFFFFF;
}

QTabBar::tab {
    background: transparent;
    padding: 10px 18px;
    min-width: 90px;
    color: #64748B;
    font-weight: 600;
    font-size: 8.5pt;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #059669;
    background: #F8FAFC;
}

QTabBar::tab:selected {
    color: #059669;
    border-bottom: 2.5px solid #10B981;
    font-weight: 700;
}

/* ----------------------------------------------------------
   Inputs Modern
---------------------------------------------------------- */
QLineEdit {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px 12px;
    color: #1E293B;
    font-size: 9pt;
    selection-background-color: #A7F3D0;
    selection-color: #064E3B;
}

QLineEdit:hover {
    border-color: #CBD5E1;
}

QLineEdit:focus {
    border-color: #10B981;
    background: #FFFFFF;
}

/* ----------------------------------------------------------
   Buttons Modern
---------------------------------------------------------- */
QPushButton {
    border-radius: 6px;
    font-weight: 600;
    font-size: 8.5pt;
    padding: 8px 16px;
}

QPushButton:disabled {
    opacity: 0.6;
    color: #94A3B8;
    background: #F1F5F9;
    border-color: #E2E8F0;
}
