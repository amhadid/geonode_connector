/* ==========================================================
   GeoNode Connector Modern Design System (main.qss)
   Selaras dengan Tema Bawaan QGIS (Light / Dark Adaptive)
   ========================================================== */

* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    outline: none;
}

/* Base Widget selaras dengan warna background window QGIS */
QWidget {
    color: palette(window-text);
    font-size: 8.5pt;
}

QLabel {
    border: none;
    background: transparent;
    color: palette(window-text);
}

/* ----------------------------------------------------------
   Scrollbar Modern Halus & Minimalis
---------------------------------------------------------- */
QScrollBar:vertical {
    width: 7px;
    background: transparent;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background: palette(midlight);
    border-radius: 3.5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #10B981;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    height: 7px;
    background: transparent;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: palette(midlight);
    border-radius: 3.5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #10B981;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ----------------------------------------------------------
   Tabs Modern Selaras Tema QGIS
---------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid palette(midlight);
    background-color: palette(window);
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    padding: 8px 16px;
    min-width: 80px;
    color: palette(window-text);
    font-weight: 600;
    font-size: 8.5pt;
    border-bottom: 2.5px solid transparent;
}

QTabBar::tab:hover {
    color: #10B981;
    background: rgba(16, 185, 129, 0.08);
    border-radius: 4px 4px 0px 0px;
}

QTabBar::tab:selected {
    color: #059669;
    border-bottom: 2.5px solid #10B981;
    font-weight: 700;
}

/* ----------------------------------------------------------
   Inputs Modern Adaptif
---------------------------------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QDateEdit, QSpinBox {
    background-color: palette(base);
    color: palette(text);
    border: 1.5px solid palette(midlight);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 8.5pt;
    selection-background-color: #A7F3D0;
    selection-color: #064E3B;
}

QLineEdit:hover, QTextEdit:hover, QComboBox:hover {
    border-color: #10B981;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border-color: #059669;
    background-color: palette(base);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid palette(midlight);
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(midlight);
    border-radius: 6px;
    selection-background-color: rgba(16, 185, 129, 0.15);
    selection-color: #059669;
    padding: 4px;
}

/* ----------------------------------------------------------
   Buttons Modern
---------------------------------------------------------- */
QPushButton {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(midlight);
    border-radius: 6px;
    font-weight: 600;
    font-size: 8.5pt;
    padding: 7px 15px;
}

QPushButton:hover {
    background-color: rgba(16, 185, 129, 0.12);
    border-color: #10B981;
    color: #059669;
}

QPushButton:pressed {
    background-color: rgba(16, 185, 129, 0.22);
}

QPushButton:disabled {
    opacity: 0.55;
    color: #94A3B8;
    background-color: palette(window);
    border-color: palette(midlight);
}

/* ----------------------------------------------------------
   Cards / Containers Modern
---------------------------------------------------------- */
QFrame.modernCard, QFrame#cardContainer {
    background-color: palette(base);
    border: 1px solid palette(midlight);
    border-radius: 8px;
}
