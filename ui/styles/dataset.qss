/* ==========================================================
   Dataset Browser Modern Styling (dataset.qss)
   Selaras dengan Tema Warna Bawaan QGIS (Light / Dark)
   ========================================================== */

/* Pastikan widget induk mewarisi background jendela QGIS */
DatasetWidget {
    background-color: transparent;
}

/* ----------------------------------------------------------
   Search Bar Row Modern
---------------------------------------------------------- */
QLineEdit#searchEdit {
    background-color: palette(base);
    color: palette(text);
    border: 1.5px solid palette(midlight);
    border-radius: 7px;
    padding: 7px 14px;
    font-size: 8.5pt;
}

QLineEdit#searchEdit:hover {
    border-color: #10B981;
}

QLineEdit#searchEdit:focus {
    border: 1.5px solid #059669;
    background-color: palette(base);
}

QPushButton#refreshButton {
    background-color: palette(button);
    border: 1.5px solid palette(midlight);
    border-radius: 7px;
    color: palette(button-text);
    font-size: 10pt;
    padding: 6px 12px;
}

QPushButton#refreshButton:hover {
    background-color: rgba(16, 185, 129, 0.12);
    border-color: #10B981;
    color: #059669;
}

QPushButton#refreshButton:pressed {
    background-color: rgba(16, 185, 129, 0.22);
}

/* ----------------------------------------------------------
   Table View Modern
---------------------------------------------------------- */
QTableView {
    background-color: palette(base);
    alternate-background-color: rgba(0, 0, 0, 0.02);
    border: 1px solid palette(midlight);
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: rgba(16, 185, 129, 0.18);
    selection-color: palette(text);
    color: palette(text);
}

QHeaderView::section {
    background-color: palette(window);
    color: palette(window-text);
    font-size: 8pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid palette(midlight);
}

QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}

QTableView::item:selected {
    background-color: rgba(16, 185, 129, 0.16);
    color: palette(text);
    font-weight: 600;
}

QTableView::item:hover {
    background-color: rgba(16, 185, 129, 0.06);
}

/* ----------------------------------------------------------
   Action Buttons Modern
---------------------------------------------------------- */
QPushButton#importButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #10B981, stop:1 #059669);
    color: #FFFFFF;
    border: none;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    padding: 8px 18px;
    font-weight: 700;
    font-size: 8.5pt;
    letter-spacing: 0.3px;
}

QPushButton#importButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #059669, stop:1 #047857);
}

QPushButton#importButton:pressed {
    background: #064E3B;
}

QPushButton#importButton:disabled {
    background: palette(midlight);
    color: #94A3B8;
}

QPushButton#importMenuButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #10B981, stop:1 #059669);
    color: #FFFFFF;
    border: none;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 0px;
    margin: 0px;
    font-size: 7.5pt;
    font-weight: 700;
    text-align: center;
}

QPushButton#importMenuButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #059669, stop:1 #047857);
}

QPushButton#importMenuButton:disabled {
    background: palette(midlight);
    color: #94A3B8;
}

QPushButton#detailButton {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(midlight);
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 8.5pt;
}

QPushButton#detailButton:hover {
    background-color: rgba(16, 185, 129, 0.12);
    border-color: #10B981;
    color: #059669;
}

QPushButton#refreshBottomButton {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(midlight);
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 8.5pt;
}

QPushButton#refreshBottomButton:hover {
    background-color: rgba(16, 185, 129, 0.12);
    border-color: #10B981;
    color: #059669;
}

QPushButton#exportButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0284C7, stop:1 #0369A1);
    color: white;
    font-weight: 700;
    border-radius: 6px;
    padding: 8px 16px;
    border: none;
    font-size: 8.5pt;
}

QPushButton#exportButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0369A1, stop:1 #075985);
}

QPushButton#exportButton:pressed {
    background: #0C4A6E;
}