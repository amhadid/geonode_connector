# =============================================================================
# GeoNode Connector - Environment Configuration Template (.env.example)
# Salin file ini menjadi .env dan sesuaikan dengan kredensial server Anda.
# =============================================================================

# Server GeoNode Utama
DEFAULT_SERVER=https://geonode-beta.jogjakota.go.id

# Kredensial Klien OAuth2 GeoNode
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Kredensial Administrator GeoServer
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=your_geoserver_password

# Kredensial Datastore Basis Data Spasial PostGIS GeoNode
POSTGIS_DEFAULT_HOST=192.168.10.83
POSTGIS_DEFAULT_PORT=5432
POSTGIS_DEFAULT_DB=project_name_data
POSTGIS_DEFAULT_USER=project_name_data
POSTGIS_DEFAULT_PASSWORD=your_postgis_password

# Kredensial Superuser PostgreSQL Backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Kredensial Basis Data Internal GeoNode
GEONODE_DATABASE=project_name
GEONODE_DATABASE_USER=project_name
GEONODE_DATABASE_PASSWORD=your_database_password
